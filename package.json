{
  "name": "@lsp-mux/vscode-eslint-lsp-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "lint": "eslint --max-warnings=0 .",
    "publish": "pnpm --recursive run publish",
    "release": "pnpm --recursive run release",
    "typecheck": "tsc && pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@gtbuchanan/eslint-config": "catalog:",
    "@gtbuchanan/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "typescript": "catalog:"
  }
}
